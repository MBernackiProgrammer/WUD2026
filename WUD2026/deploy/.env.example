# Copy to deploy/.env (ignored); set values through your deployment secret store.
SITE_HOST=wud2026.berntech.pl
PUBLIC_SITE_URL=https://wud2026.berntech.pl
# SITE_ADDRESS=http://localhost  # optional local HTTP smoke test, no automatic TLS
PUBLIC_API_URL=/api
PUBLIC_ADMIN_URL=/admin/
INTERNAL_API_URL=http://api:8080/api
HTTP_BIND=80
HTTPS_BIND=443
POSTGRES_DB=WUD2027
POSTGRES_USER=filharmonia
# Required: generate a unique random password. No real secrets belong in this example.
POSTGRES_PASSWORD=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSL_MODE=Prefer
DATABASE_MIGRATE=true
TZ=Europe/Warsaw
REQUIRE_CONFIRMED_EMAIL=true
# First administrator only; clear both after creation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_MAX_OUTPUT_TOKENS=4000
AI_SESSION_DAYS=7
AI_MAX_TURNS=50
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Multiline PEM can use literal backslash-n separators.
APPLE_PRIVATE_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
LOG_LEVEL=Warning
PUBLICATION_INTERVAL_SECONDS=5
# Change these together if this private subnet conflicts with your infrastructure.
GATEWAY_IP=172.30.240.2
NETWORK_SUBNET=172.30.240.0/24
NETWORK_IP_RANGE=172.30.240.128/25
